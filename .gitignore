outputs/sample_captions/*.png
outputs/*.png

# Python
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
venv/
env/
*.egg-info/

# OS
.DS_Store
Thumbs.db

# Keep folder structure with placeholder files
!data/raw/.gitkeep
!data/features/.gitkeep
!data/processed/.gitkeep
!checkpoints/.gitkeep
!outputs/sample_captions/.gitkeep
